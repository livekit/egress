#!/bin/bash
set -euo pipefail

# Deletes everything under /compiled-binaries except the plugins providing an
# element listed in $1. Fails if any listed element is not installed.
elements=$1
keep=$(mktemp)

while read -r element; do
  if ! info=$(gst-inspect-1.0 "$element" 2>&1); then
    echo "element not found: $element" >&2
    exit 1
  fi
  basename "$(awk '/^  Filename/ {print $2}' <<< "$info")"
done < <(grep -v -e '^#' -e '^$' "$elements") | sort -u > "$keep"

find /compiled-binaries ! -type d | while read -r file; do
  if ! grep -qxF "$(basename "$file")" "$keep"; then
    rm "$file"
  fi
done
find /compiled-binaries -type d -empty -delete

echo "gst-plugins-rs files kept:"
find /compiled-binaries ! -type d
